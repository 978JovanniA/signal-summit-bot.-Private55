name: Signal Summit Weekly Newsletter

on:
  schedule:
    # Runs every Sunday at 18:00 UTC (2:00 PM ET / 1:00 PM during EST).
    # Cron is always in UTC — change the numbers below to shift the time.
    # Format: minute hour day-of-month month day-of-week
    - cron: "0 18 * * 0"
  workflow_dispatch: {} # lets you click "Run workflow" in the Actions tab to test on demand

jobs:
  post-newsletter:
    runs-on: ubuntu-latest
    steps:
      - name: Check out repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Generate and post newsletter
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          DISCORD_WEBHOOK_URL: ${{ secrets.DISCORD_WEBHOOK_URL }}
        run: python discord_newsletter_bot.py
